load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

# JPEG is available in BCR via libjpeg_turbo
bool_flag(
    name = "with_jpeg",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "_with_jpeg",
    flag_values = {":with_jpeg": "True"},
)

# SIMD opt-out flags (mirrors LIBYUV_DISABLE_* defines from row.h).
# These flags force-disable the corresponding kernels even on matching hardware.

bool_flag(
    name = "disable_x86",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "_disable_x86",
    flag_values = {":disable_x86": "True"},
)

bool_flag(
    name = "disable_neon",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "_disable_neon",
    flag_values = {":disable_neon": "True"},
)

bool_flag(
    name = "disable_msa",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "_disable_msa",
    flag_values = {":disable_msa": "True"},
)

bool_flag(
    name = "disable_mmi",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "_disable_mmi",
    flag_values = {":disable_mmi": "True"},
)

# Identify GNU-style AArch64 compilers for the NEON architecture flags.
selects.config_setting_group(
    name = "_aarch64_gcc",
    match_all = [
        "@platforms//cpu:aarch64",
        "@rules_cc//cc/compiler:gcc",
    ],
)

# Keep SVE limited to the Clang toolchains used by presubmit.
selects.config_setting_group(
    name = "_aarch64_clang",
    match_all = [
        "@platforms//cpu:aarch64",
        "@rules_cc//cc/compiler:clang",
    ],
)

# GCC and Clang both assemble the upstream NEON dot-product and i8mm kernels.
selects.config_setting_group(
    name = "_aarch64_neon_compiler",
    match_any = [
        ":_aarch64_clang",
        ":_aarch64_gcc",
    ],
)

# ===== Internal headers ========================================================

cc_library(
    name = "_hdrs",
    hdrs = [
        "include/libyuv.h",
        "include/libyuv/basic_types.h",
        "include/libyuv/compare.h",
        "include/libyuv/compare_row.h",
        "include/libyuv/convert.h",
        "include/libyuv/convert_argb.h",
        "include/libyuv/convert_from.h",
        "include/libyuv/convert_from_argb.h",
        "include/libyuv/cpu_id.h",
        "include/libyuv/cpu_support.h",
        "include/libyuv/loongson_intrinsics.h",
        "include/libyuv/mjpeg_decoder.h",
        "include/libyuv/planar_functions.h",
        "include/libyuv/rotate.h",
        "include/libyuv/rotate_argb.h",
        "include/libyuv/rotate_row.h",
        "include/libyuv/row.h",
        "include/libyuv/row_sve.h",
        "include/libyuv/scale.h",
        "include/libyuv/scale_argb.h",
        "include/libyuv/scale_rgb.h",
        "include/libyuv/scale_row.h",
        "include/libyuv/scale_uv.h",
        "include/libyuv/version.h",
        "include/libyuv/video_common.h",
    ],
    # Keep dispatch and direct calls from consumers consistent with built kernels.
    defines = ["LIBYUV_DISABLE_SME"] + select({
        ":_disable_neon": ["LIBYUV_DISABLE_NEON"],
        "//conditions:default": [],
    }) + select({
        ":_aarch64_clang": [],
        "//conditions:default": ["LIBYUV_DISABLE_SVE"],
    }),
    includes = ["include"],
)

# ===== Architecture-specific acceleration ======================================

# NEON (matches upstream libyuv_neon OBJECT library from BUILD.gn).
# Tagged "manual" so @libyuv//... does not attempt to build on non-ARM
# platforms; pulled in only via the ARM selects in :yuv deps.
# Opting out omits the objects, so older compilers never assemble these kernels.
cc_library(
    name = "_neon",
    srcs = select({
        ":_disable_neon": [],
        "//conditions:default": [
            "source/compare_neon.cc",
            "source/compare_neon64.cc",
            "source/rotate_neon.cc",
            "source/rotate_neon64.cc",
            "source/row_neon.cc",
            "source/row_neon64.cc",
            "source/scale_neon.cc",
            "source/scale_neon64.cc",
        ],
    }),
    copts = select({
        "@rules_cc//cc/compiler:msvc-cl": ["/W0"],
        "//conditions:default": [
            "-w",
            "-ffp-contract=fast",
        ],
    }) + select({
        "@platforms//cpu:armv7": ["-mfpu=neon"],
        ":_aarch64_neon_compiler": ["-march=armv8-a+dotprod+i8mm"],
        "//conditions:default": [],
    }),
    tags = ["manual"],
    deps = [":_hdrs"],
)

# SVE (matches upstream libyuv_sve OBJECT library from BUILD.gn).
cc_library(
    name = "_sve",
    srcs = [
        "source/row_sve.cc",
    ],
    copts = select({
        "@rules_cc//cc/compiler:msvc-cl": ["/W0"],
        "//conditions:default": [
            "-w",
            "-ffp-contract=fast",
            "-march=armv9-a+i8mm+sve2",
        ],
    }),
    local_defines = ["LIBYUV_SVE"],
    tags = ["manual"],
    deps = [":_hdrs"],
)

# ===== Library =================================================================

alias(
    name = "libyuv",
    actual = ":yuv",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "yuv",
    srcs = [
        "source/compare.cc",
        "source/compare_common.cc",
        "source/compare_gcc.cc",
        "source/compare_win.cc",
        "source/convert.cc",
        "source/convert_argb.cc",
        "source/convert_from.cc",
        "source/convert_from_argb.cc",
        "source/convert_jpeg.cc",
        "source/convert_to_argb.cc",
        "source/convert_to_i420.cc",
        "source/cpu_id.cc",
        "source/mjpeg_decoder.cc",
        "source/mjpeg_validate.cc",
        "source/planar_functions.cc",
        "source/rotate.cc",
        "source/rotate_any.cc",
        "source/rotate_argb.cc",
        "source/rotate_common.cc",
        "source/rotate_gcc.cc",
        "source/rotate_lsx.cc",
        "source/rotate_win.cc",
        "source/row_any.cc",
        "source/row_common.cc",
        "source/row_gcc.cc",
        "source/row_lasx.cc",
        "source/row_lsx.cc",
        "source/row_rvv.cc",
        "source/row_win.cc",
        "source/scale.cc",
        "source/scale_any.cc",
        "source/scale_argb.cc",
        "source/scale_common.cc",
        "source/scale_gcc.cc",
        "source/scale_lsx.cc",
        "source/scale_rgb.cc",
        "source/scale_rvv.cc",
        "source/scale_uv.cc",
        "source/scale_win.cc",
        "source/video_common.cc",
    ],
    copts = select({
        "@rules_cc//cc/compiler:msvc-cl": ["/W0"],
        "//conditions:default": [
            "-w",
            "-ffp-contract=fast",
        ],
    }),
    local_defines = select({
        ":_with_jpeg": ["HAVE_JPEG"],
        "//conditions:default": [],
    }) + select({
        ":_disable_x86": ["LIBYUV_DISABLE_X86"],
        "//conditions:default": [],
    }) + select({
        ":_disable_msa": ["LIBYUV_DISABLE_MSA"],
        "//conditions:default": [],
    }) + select({
        ":_disable_mmi": ["LIBYUV_DISABLE_MMI"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [":_hdrs"] +
           select({
               "@platforms//cpu:aarch64": [":_neon"],
               "@platforms//cpu:armv7": [":_neon"],
               "//conditions:default": [],
           }) +
           select({
               ":_aarch64_clang": [":_sve"],
               "//conditions:default": [],
           }) +
           select({
               ":_with_jpeg": ["@libjpeg_turbo//:jpeg"],
               "//conditions:default": [],
           }),
)
